# Razorpay Payment Gateway Configuration
# Get your API Keys from: Razorpay Dashboard -> Settings -> API Keys
# Test Mode Key starts with 'rzp_test_', Live Mode Key starts with 'rzp_live_'
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Optional Webhook Secret from Razorpay Dashboard -> Settings -> Webhooks
# Set Webhook URL in Razorpay Dashboard to: https://yourdomain.com/api/razorpay/webhook
# Subscribe to: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
VITE_RAZORPAY_ME_URL=https://razorpay.me/@srikandanfamilyshop
RAZORPAY_ME_URL=https://razorpay.me/@srikandanfamilyshop

