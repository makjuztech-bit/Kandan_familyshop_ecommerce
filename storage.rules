rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public website images are publicly viewable by visitors
    // Uploads, replacements, and deletions enabled for admin workflows
    match /website-images/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
